---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../data/company';
import { DEMO } from '../lib/env';
import { url } from '../lib/url';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const fullTitle = Astro.url.pathname === import.meta.env.BASE_URL ? `${company.name} — Aerospace and defense forgings, Cheshire, CT` : `${title} | ${company.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  name: company.name,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  telephone: '+1-203-272-5371',
  email: company.email,
  foundingDate: String(company.founded),
  address: { '@type': 'PostalAddress', streetAddress: company.street, addressLocality: company.city, addressRegion: company.region, postalCode: company.postal, addressCountry: company.country },
  parentOrganization: { '@type': 'Organization', name: 'American Industrial Acquisition Corporation' },
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(DEMO || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#17202b" />
    <link rel="icon" href={url('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {DEMO && (
      <div class="demo-bar" role="note">
        <div class="wrap">
          <strong>Preview build.</strong> Not indexed by search engines. Items marked <span class="demo-bar__q" aria-hidden="true">?</span> await confirmation from CII. <a href={url('/launch-checklist/')}>Launch checklist</a>
        </div>
      </div>
    )}
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
<style>
  .demo-bar { background: #fbf6ea; border-bottom: 1px solid #ead9b0; color: #5b4310; font-size: var(--t-xs); padding-block: 0.45rem; }
  .demo-bar a { color: #5b4310; font-weight: 600; }
  .demo-bar__q { display: inline-grid; place-items: center; width: 1rem; height: 1rem; border: 1px dashed var(--straw); border-radius: 50%; font-weight: 700; font-size: 0.65rem; }
  main:focus { outline: none; }
</style>
