---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import CtaBand from '../components/CtaBand.astro';
import Pillars from '../components/Pillars.astro';
import Photo from '../components/Photo.astro';
import { company } from '../data/company';
import { limits, process, presses, hammers } from '../data/capabilities';
import { markets, programs } from '../data/markets';
import { certifications } from '../data/quality';
import { slides, pillars, decades } from '../data/home';
import { url } from '../lib/url';
const years = new Date().getFullYear() - company.founded;
const maxPress = Math.max(...presses.map((p) => p.tons));
const maxHammer = hammers.range.split(' to ').pop();
const parts = [
  { slug: 'part-uh60-rotor-link', label: 'UH-60 Black Hawk rotor links' },
  { slug: 'part-nozzles', label: 'Stainless steel fuel nozzles' },
  { slug: 'part-737-attach-bolt', label: 'Boeing 737 engine attach bolts, Inconel 718' },
  { slug: 'part-large-titanium', label: 'Large titanium forgings' },
  { slug: 'part-f15-fuel-injector-valve', label: 'F-15 fuel injector valve bodies' },
  { slug: 'part-aluminum-structural', label: 'Aluminum structural forgings' },
  { slug: 'part-magnesium', label: 'Magnesium forgings' },
  { slug: 'part-missile-aluminum', label: 'Aluminum missile forgings' },
];
const featured = ['UH-60 Black Hawk', 'CH-53K King Stallion', 'CH-47 Chinook', 'AH-64 Apache', 'Boeing 787', 'Boeing 737', 'C-130', 'Sikorsky S-92'];
const certNames = certifications.map((c) => c.name);
---
<Base title="Home" description={`Closed-die and open-die forgings in titanium, aluminum, steel and nickel alloys for aerospace and defense. AS9100 Rev D, NADCAP-accredited heat treating and NDT. Cheshire, Connecticut, since ${company.founded}.`}>
  <HeroCarousel slides={slides}>
    <dl class="plate" slot="aside" aria-label="Shop at a glance">
      <div><dt>Presses to</dt><dd>{maxPress.toLocaleString('en-US')} tons</dd></div>
      <div><dt>Hammers to</dt><dd>{maxHammer}</dd></div>
      <div><dt>Forgings to</dt><dd>250 lb</dd></div>
      <div><dt>Forging since</dt><dd>{company.founded}</dd></div>
    </dl>
  </HeroCarousel>

  <FeatureSplit id="about-title" photo="team" eyebrow="About us" title="The Consolidated difference" action={{ href: '/company/#mission', label: 'Our mission' }}>
    <p>For over {decades} years, {company.name} has provided outstanding service throughout the forging, machining, shipment and customer-care processes for the aerospace industry. Providing high-quality forgings from ferrous, non-ferrous and exotic metals is just a small part of what we can offer our customers.</p>
    <p>Today, Consolidated is a key supplier to the aircraft, defense, turbine engine, transportation and industrial markets that require precision, quality components. We make products used on military helicopters, military fixed-wing aircraft, aircraft engines, commercial airliners, commercial helicopters and more.</p>
  </FeatureSplit>

  <CtaBand id="project-title" photo="press-floor" eyebrow="The Consolidated choice" title="Do you have a project we can help with?" action={{ href: '/contact/#rfq', label: 'Contact us to get started' }}>
    <p>Consolidated makes forgings used on military helicopters, military fixed-wing aircraft, aircraft engines, commercial airliners and commercial helicopters, including the Sikorsky UH-60 Black Hawk, S-92 and S-76, the CH-53K King Stallion, the Boeing CH-46 and CH-47 Chinook, the AH-64 Apache, the Boeing 737 and 787, and the Lockheed C-130. Tell us about your part and we will tell you what we can do.</p>
  </CtaBand>

  <Pillars id="experience-title" title="Market experience" lede={`${years} years of forging and machining have given us deep expertise in the sectors we serve.`} items={pillars} />

  <section class="section section--paper" aria-labelledby="limits-title">
    <div class="wrap split">
      <div class="section-head">
        <h2 id="limits-title">Will your part fit?</h2>
        <p>Maximum forging weight and plan-view area by material. Plan-view area is the part’s footprint seen from above the die.</p>
        <p><a href={url('/capabilities/')}>Full equipment list and materials</a></p>
      </div>
      <div class="table-scroll">
        <table class="spec">
          <caption class="visually-hidden">Forging size limits by material</caption>
          <thead><tr><th scope="col">Material</th><th scope="col">Equipment</th><th scope="col" class="num">Max weight</th><th scope="col" class="num">Max plan-view area</th></tr></thead>
          <tbody>
            {limits.map((r) => (
              <tr><th scope="row">{r.material}</th><td data-label="Equipment">{r.equipment}</td><td class="num" data-label="Max weight">{r.weightLb} lb</td><td class="num" data-label="Max plan-view area">{r.areaSqIn} in²</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="route-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="route-title">From die design to certified part, under one roof</h2>
        <p>Engineering, forging, heat treat, inspection and lab testing all happen in our Cheshire plant, so one team owns your part from model to shipment.</p>
      </div>
      <ol class="route">
        {process.map((s, i) => (
          <li><Photo slug={s.photo} class="route__img" sizes="(min-width: 62rem) 16vw, (min-width: 34rem) 50vw, 100vw" /><span class="route__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.step}</h3><p>{s.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="parts-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="parts-title">Parts we’ve forged</h2>
        <p>A few of the forgings that have left our Cheshire plant, from titanium rotor links to Inconel engine bolts.</p>
      </div>
      <ul class="parts">
        {parts.map((p) => (
          <li><Photo slug={p.slug} sizes="(min-width: 62rem) 25vw, 50vw" /><span>{p.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--steel" aria-labelledby="markets-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="markets-title">Flying on the platforms you know</h2>
        <p>Flight-safety and flight-critical forgings for military, commercial and general aviation, plus engines, vehicles, ships and industrial equipment.</p>
      </div>
      <ul class="markets">
        {markets.map((m) => (
          <li><a href={url(`/markets/${m.slug}/`)}><h3>{m.name}</h3><p>{m.short}</p></a></li>
        ))}
      </ul>
      <div class="programs">
        <h3>Programs we have supplied</h3>
        <ul class="chips chips--steel">{featured.map((p) => <li>{p}</li>)}</ul>
        <p><a href={url('/markets/programs/')}>All {programs.reduce((n, g) => n + g.items.length, 0)} programs</a></p>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="quality-title">
    <div class="wrap split">
      <div class="section-head">
        <h2 id="quality-title">Accredited where it matters</h2>
        <p>Our quality system and special processes are audited by the registrars and primes our customers rely on.</p>
        <p><a href={url('/quality/')}>Certifications, approvals and supplier documents</a></p>
      </div>
      <ul class="certs">
        {certifications.map((c) => (
          <li><strong>{c.name}</strong><span>{c.scope}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <FeatureSplit id="partner-title" photo="hammer-cell" eyebrow="Moving forward" title="Your trusted partner for critical components" reverse action={{ href: '/capabilities/', label: 'Forging capabilities' }}>
    <p>{company.name} is a leading provider of precision-forged components for high-technology industries. With more than {decades} years of experience, we specialize in complex parts for aerospace, defense, transportation and industrial customers. Our {company.city}, Connecticut plant runs hydraulic and mechanical presses to {maxPress.toLocaleString('en-US')} tons and programmable hammers to {maxHammer}, with heat treating, nondestructive testing and a metallurgical laboratory in house.</p>
    <p>We are certified to {certNames[0]} and {certNames[1]} and NADCAP-accredited for heat treating and nondestructive testing. We work with customers from design through production to optimize part performance and shorten lead times.</p>
  </FeatureSplit>

  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <h2 id="next-title" class="visually-hidden">Next steps</h2>
      <div class="grid-2">
        <div class="panel cta">
          <h3>Quote a forging</h3>
          <p>Tell us the material, size and quantity. We reply with questions or a quote, and send a secure link for any drawings.</p>
          <a class="btn btn--primary" href={url('/contact/#rfq')}>Request a quote</a>
        </div>
        <div class="panel cta">
          <h3>Build a career in forging</h3>
          <p>{years} years in, we are still looking for people with engineering drive and forging or machining experience.</p>
          <a class="btn btn--ghost" href={url('/careers/')}>Careers at Consolidated</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Nameplate: modelled on a stamped machine data plate; sits in the carousel's control bar */
  .plate { display: grid; grid-template-columns: repeat(4, auto); margin: 0;
    border: 1px solid rgb(232 237 242 / 0.35); border-radius: 4px; background: rgb(23 32 43 / 0.72); backdrop-filter: blur(6px); }
  .plate div { padding: var(--s-3) var(--s-5); border-right: 1px solid rgb(232 237 242 / 0.18); }
  .plate div:last-child { border-right: 0; }
  .plate dt { font-size: var(--t-xs); color: var(--on-steel-2); font-variation-settings: var(--narrow); white-space: nowrap; }
  .plate dd { margin: 0; font-size: var(--t-lg); font-weight: 700; font-variation-settings: 'wdth' 120; font-variant-numeric: tabular-nums; white-space: nowrap; }
  @media (max-width: 56rem) {
    .plate { grid-template-columns: 1fr 1fr; width: 100%; }
    .plate div { border-bottom: 1px solid rgb(232 237 242 / 0.18); }
    .plate div:nth-child(even) { border-right: 0; }
    .plate div:nth-last-child(-n + 2) { border-bottom: 0; }
  }

  .route { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); border-top: 2px solid var(--ink); counter-reset: none; }
  .route li { padding: var(--s-5) var(--s-3) 0; border-right: 1px solid var(--rule); }
  .route li:last-child { border-right: 0; }
  .route :global(.route__img) { margin-bottom: var(--s-3); }
  .route :global(.route__img img) { aspect-ratio: 3 / 2; }
  .parts { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-5) var(--s-4); }
  .parts li { display: grid; gap: var(--s-2); }
  .parts span { font-size: var(--t-sm); color: var(--ink-2); }
  @media (max-width: 52rem) { .parts { grid-template-columns: repeat(2, 1fr); } }
  .route__n { display: block; font-size: var(--t-xs); font-weight: 700; color: var(--temper); font-variation-settings: var(--narrow); margin-bottom: var(--s-2); }
  .route h3 { font-size: var(--t-md); margin-bottom: var(--s-2); }
  .route p { font-size: var(--t-sm); color: var(--ink-2); }
  @media (max-width: 62rem) {
    .route { grid-template-columns: 1fr 1fr; }
    .route li { border-right: 0; border-bottom: 1px solid var(--rule); padding: var(--s-4) var(--s-4) var(--s-4) 0; }
  }
  @media (max-width: 34rem) { .route { grid-template-columns: 1fr; } }

  .markets { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--steel-2); border: 1px solid var(--steel-2); }
  .markets a { display: block; height: 100%; padding: var(--s-5); background: var(--steel); color: var(--on-steel); text-decoration: none; }
  .markets a:hover { background: var(--steel-2); }
  .markets a:hover h3 { text-decoration: underline; text-underline-offset: 0.2em; }
  .markets h3 { margin-bottom: var(--s-2); }
  .markets p { color: var(--on-steel-2); font-size: var(--t-sm); }
  @media (max-width: 62rem) { .markets { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .markets { grid-template-columns: 1fr; } }
  .programs { margin-top: var(--s-7); display: grid; gap: var(--s-4); }
  .programs h3 { font-size: var(--t-md); color: var(--on-steel); }
  .chips--steel li { background: transparent; border-color: rgb(232 237 242 / 0.3); color: var(--on-steel); }

  .certs { list-style: none; border-top: 2px solid var(--ink); }
  .certs li { display: grid; grid-template-columns: minmax(0, 15rem) 1fr; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: 1px solid var(--rule-soft); }
  .certs strong { font-variation-settings: 'wdth' 108; }
  .certs span { color: var(--ink-2); }
  @media (max-width: 34rem) { .certs li { grid-template-columns: 1fr; gap: var(--s-1); } }

  .cta { display: grid; gap: var(--s-4); justify-items: start; padding: var(--s-6); }
</style>
