---
import Base from '../layouts/Base.astro';
import GrainFlow from '../components/GrainFlow.astro';
import Confirm from '../components/Confirm.astro';
import { company } from '../data/company';
import { limits, process, presses } from '../data/capabilities';
import { markets, programs } from '../data/markets';
import { certifications } from '../data/quality';
import { url } from '../lib/url';
const years = new Date().getFullYear() - company.founded;
const maxPress = Math.max(...presses.map((p) => p.tons));
const featured = ['UH-60 Black Hawk', 'CH-53K King Stallion', 'CH-47 Chinook', 'AH-64 Apache', 'Boeing 787', 'Boeing 737', 'C-130', 'Sikorsky S-92'];
---
<Base title="Home" description={`Closed-die and open-die forgings in titanium, aluminum, steel and nickel alloys for aerospace and defense. AS9100D, NADCAP heat treat and NDT. Cheshire, Connecticut, since ${company.founded}.`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__art"><GrainFlow preset="hero" animate /></div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <h1 id="hero-title">Forgings for parts that cannot fail.</h1>
        <p class="hero__lede">Titanium, aluminum, steel and nickel-alloy forgings for aircraft, rotorcraft, engines and defense — engineered, forged, heat treated and tested in Cheshire, Connecticut since {company.founded}.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={url('/contact/#rfq')}>Request a quote</a>
          <a class="btn btn--ghost" href={url('/capabilities/')}>See capabilities</a>
        </div>
      </div>
      <dl class="plate" aria-label="Shop at a glance">
        <div><dt>Presses to</dt><dd>{maxPress.toLocaleString('en-US')} t</dd></div>
        <div><dt>Hammers to</dt><dd>160 kJ</dd></div>
        <div><dt>Forgings to</dt><dd>250 lb<Confirm id="max-weight" /></dd></div>
        <div><dt>Forging since</dt><dd>{company.founded}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="limits-title">
    <div class="wrap split">
      <div class="section-head">
        <h2 id="limits-title">Will your part fit?</h2>
        <p>Maximum forging weight and plan-view area by material. Plan-view area is the part’s footprint seen from above the die.</p>
        <p><a href={url('/capabilities/')}>Full equipment list and materials</a></p>
      </div>
      <div class="table-scroll">
        <table class="spec">
          <caption class="visually-hidden">Forging size limits by material</caption>
          <thead><tr><th scope="col">Material</th><th scope="col">Equipment</th><th scope="col" class="num">Max weight</th><th scope="col" class="num">Max plan area</th></tr></thead>
          <tbody>
            {limits.map((r) => (
              <tr><th scope="row">{r.material}</th><td>{r.equipment}</td><td class="num">{r.weightLb} lb</td><td class="num">{r.areaSqIn} in²</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="route-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="route-title">From die design to certified part, under one roof</h2>
        <p>Engineering, forging, heat treat, inspection and lab testing all happen in our Cheshire plant, so one team owns your part from model to shipment.<Confirm id="machining" /></p>
      </div>
      <ol class="route">
        {process.map((s, i) => (
          <li><span class="route__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.step}</h3><p>{s.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--steel" aria-labelledby="markets-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="markets-title">Flying on the platforms you know</h2>
        <p>Flight-safety and flight-critical forgings for military, commercial and general aviation, and for the ships, vehicles and engines that support them.</p>
      </div>
      <ul class="markets">
        {markets.map((m) => (
          <li><a href={url(`/markets/${m.slug}/`)}><h3>{m.name}</h3><p>{m.short}</p></a></li>
        ))}
      </ul>
      <div class="programs">
        <h3>Programs we have supplied<Confirm id="programs" /></h3>
        <ul class="chips chips--steel">{featured.map((p) => <li>{p}</li>)}</ul>
        <p><a href={url('/markets/programs/')}>All {programs.reduce((n, g) => n + g.items.length, 0)} programs</a></p>
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="quality-title">
    <div class="wrap split">
      <div class="section-head">
        <h2 id="quality-title">Accredited where it matters</h2>
        <p>Our quality system and special processes are audited by the registrars and primes our customers rely on.</p>
        <p><a href={url('/quality/')}>Certifications, approvals and supplier documents</a></p>
      </div>
      <ul class="certs">
        {certifications.map((c) => (
          <li><strong>{c.name}</strong><span>{c.scope}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <h2 id="next-title" class="visually-hidden">Next steps</h2>
      <div class="grid-2">
        <div class="panel cta">
          <h3>Quote a forging</h3>
          <p>Tell us the material, size and quantity. We reply with questions or a quote, and send a secure link for any drawings.</p>
          <a class="btn btn--primary" href={url('/contact/#rfq')}>Start a request</a>
        </div>
        <div class="panel cta">
          <h3>Build a career in forging</h3>
          <p>{years} years in, we are still looking for people with engineering drive and forging or machining experience.</p>
          <a class="btn btn--ghost" href={url('/careers/')}>Careers at Consolidated</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; background: var(--steel); color: var(--on-steel); overflow: hidden; isolation: isolate; }
  .hero__art { position: absolute; inset: 0; z-index: -1; }
  .hero__art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--steel) 0%, rgb(28 38 50 / 0.86) 34%, rgb(28 38 50 / 0.1) 72%); }
  .hero__inner { min-height: min(46rem, 88vh); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; gap: var(--s-7); padding-block: var(--s-9) var(--s-8); }
  .hero h1 { font-size: clamp(2.5rem, 1.4rem + 4.6vw, 5rem); line-height: 1.02; font-variation-settings: 'wdth' 125; letter-spacing: -0.025em; max-width: 13ch; }
  .hero__lede { margin-top: var(--s-5); font-size: var(--t-lg); color: var(--on-steel-2); max-width: 34rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .hero .btn--ghost { color: var(--on-steel); }

  /* Nameplate: modelled on a stamped machine data plate */
  .plate { justify-self: end; display: grid; grid-template-columns: 1fr 1fr; margin: 0; min-width: min(100%, 22rem);
    border: 1px solid rgb(232 237 242 / 0.35); border-radius: 4px; background: rgb(23 32 43 / 0.72); backdrop-filter: blur(6px); }
  .plate div { padding: var(--s-4) var(--s-5); border-bottom: 1px solid rgb(232 237 242 / 0.18); }
  .plate div:nth-child(odd) { border-right: 1px solid rgb(232 237 242 / 0.18); }
  .plate div:nth-last-child(-n + 2) { border-bottom: 0; }
  .plate dt { font-size: var(--t-xs); color: var(--on-steel-2); font-variation-settings: var(--narrow); }
  .plate dd { margin: 0; font-size: var(--t-xl); font-weight: 700; font-variation-settings: 'wdth' 120; font-variant-numeric: tabular-nums; }
  @media (max-width: 56rem) {
    .hero__inner { grid-template-columns: 1fr; align-items: start; padding-block: var(--s-8) var(--s-7); min-height: 0; }
    .hero__art::after { background: linear-gradient(180deg, rgb(28 38 50 / 0.55), var(--steel) 85%); }
    .plate { justify-self: stretch; }
  }

  .route { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); border-top: 2px solid var(--ink); counter-reset: none; }
  .route li { padding: var(--s-5) var(--s-4) 0 0; border-right: 1px solid var(--rule); padding-left: var(--s-4); }
  .route li:first-child { padding-left: 0; }
  .route li:last-child { border-right: 0; }
  .route__n { display: block; font-size: var(--t-xs); font-weight: 700; color: var(--temper); font-variation-settings: var(--narrow); margin-bottom: var(--s-2); }
  .route h3 { font-size: var(--t-md); margin-bottom: var(--s-2); }
  .route p { font-size: var(--t-sm); color: var(--ink-2); }
  @media (max-width: 62rem) {
    .route { grid-template-columns: 1fr 1fr; }
    .route li { border-right: 0; border-bottom: 1px solid var(--rule); padding: var(--s-4) var(--s-4) var(--s-4) 0; }
  }
  @media (max-width: 34rem) { .route { grid-template-columns: 1fr; } }

  .markets { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--steel-2); border: 1px solid var(--steel-2); }
  .markets a { display: block; height: 100%; padding: var(--s-5); background: var(--steel); color: var(--on-steel); text-decoration: none; }
  .markets a:hover { background: var(--steel-2); }
  .markets a:hover h3 { text-decoration: underline; text-underline-offset: 0.2em; }
  .markets h3 { margin-bottom: var(--s-2); }
  .markets p { color: var(--on-steel-2); font-size: var(--t-sm); }
  @media (max-width: 62rem) { .markets { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 34rem) { .markets { grid-template-columns: 1fr; } }
  .programs { margin-top: var(--s-7); display: grid; gap: var(--s-4); }
  .programs h3 { font-size: var(--t-md); color: var(--on-steel); }
  .chips--steel li { background: transparent; border-color: rgb(232 237 242 / 0.3); color: var(--on-steel); }

  .certs { list-style: none; border-top: 2px solid var(--ink); }
  .certs li { display: grid; grid-template-columns: minmax(0, 15rem) 1fr; gap: var(--s-4); padding: var(--s-4) 0; border-bottom: 1px solid var(--rule-soft); }
  .certs strong { font-variation-settings: 'wdth' 108; }
  .certs span { color: var(--ink-2); }
  @media (max-width: 34rem) { .certs li { grid-template-columns: 1fr; gap: var(--s-1); } }

  .cta { display: grid; gap: var(--s-4); justify-items: start; padding: var(--s-6); }
</style>
