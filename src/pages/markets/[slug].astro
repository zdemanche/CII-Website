---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionNav from '../../components/SectionNav.astro';
import Photo from '../../components/Photo.astro';
import { markets, type Market } from '../../data/markets';
import { marketLinks } from '../../data/sections';
import { url } from '../../lib/url';
export function getStaticPaths() {
  return markets.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props as { m: Market };
---
<Base title={m.name} description={m.summary}>
  <PageHeader preset="markets" title={m.name} lede={m.summary} crumbs={[{ href: '/markets/', label: 'Markets' }]} />
  <SectionNav label="Markets" links={marketLinks} />
  <section class="section section--paper">
    <div class={m.examples?.length ? 'wrap split market' : 'wrap market market--single'}>
      <div class="market__copy">
        <div class="section-head">
          {m.detail.map((d) => <p>{d}</p>)}
        </div>
        <div class="next">
          <a class="btn btn--primary" href={url('/contact/#rfq')}>Request a quote</a>
          <a class="btn btn--ghost" href={url('/capabilities/materials/')}>Materials we forge</a>
        </div>
      </div>
      {m.examples?.length ? (
        <div class="market__apps">
          <h2 class="sub">Typical applications</h2>
          <ul class="ticks">{m.examples.map((e) => <li>{e}</li>)}</ul>
        </div>
      ) : null}
    </div>
    <div class="wrap gallery">
      {m.photos.map((slug) => <Photo slug={slug} sizes="(min-width: 48rem) 33vw, 100vw" />)}
    </div>
  </section>
</Base>
<style>
  .sub { font-size: var(--t-lg); margin-bottom: var(--s-4); }
  .market { align-items: start; }
  .market .section-head { margin-bottom: 0; }
  .next { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); margin-top: var(--s-7); }
  @media (max-width: 48rem) { .gallery { grid-template-columns: 1fr 1fr; } }
</style>
