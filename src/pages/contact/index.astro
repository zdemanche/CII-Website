---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Confirm from '../../components/Confirm.astro';
import { company } from '../../data/company';
import { materials } from '../../data/capabilities';
import { DEMO, RFQ_ENDPOINT } from '../../lib/env';
import { url } from '../../lib/url';
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.mapQuery)}`;
const families = materials.map((m) => m.family);
---
<Base title="Contact and request a quote" description={`Request a forging quote or contact ${company.name}, ${company.street}, ${company.city}, ${company.region}. Phone ${company.phone}.`}>
  <PageHeader preset="contact" title="Request a quote" lede="Tell us about the part and we’ll reply with questions or a quote." />

  <section class="section section--paper" id="rfq" aria-labelledby="rfq-title">
    <div class="wrap rfq">
      <div class="rfq__form">
        <h2 id="rfq-title">Your request</h2>
        <div class="cui" role="note">
          <strong>Do not include drawings or controlled technical data.</strong>
          <p>This form does not accept files. Drawings and models for aerospace and defense parts may be ITAR- or EAR-controlled, so after we receive your request we send a secure transfer link for them.<Confirm id="rfq-routing" /></p>
        </div>

        <div class="errors" data-errors tabindex="-1" hidden>
          <h3>Please fix these fields</h3>
          <ul data-error-list></ul>
        </div>

        <form data-rfq novalidate method="post" action={RFQ_ENDPOINT || undefined} data-demo={DEMO || !RFQ_ENDPOINT ? 'true' : 'false'}>
          <fieldset>
            <legend>Contact</legend>
            <div class="row">
              <div class="field"><label for="name">Name <span class="req">required</span></label><input id="name" name="name" autocomplete="name" required /></div>
              <div class="field"><label for="company">Company <span class="req">required</span></label><input id="company" name="company" autocomplete="organization" required /></div>
            </div>
            <div class="row">
              <div class="field"><label for="email">Work email <span class="req">required</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
              <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
            </div>
          </fieldset>

          <fieldset>
            <legend>Part</legend>
            <div class="row">
              <div class="field">
                <label for="material">Material family <span class="req">required</span></label>
                <select id="material" name="material" required>
                  <option value="">Choose a material</option>
                  {families.map((f) => <option>{f}</option>)}
                  <option>Not sure yet</option>
                </select>
              </div>
              <div class="field"><label for="alloy">Alloy or specification</label><input id="alloy" name="alloy" placeholder="e.g. Ti 6Al-4V, AMS 4928" /></div>
            </div>
            <div class="field">
              <label for="description">Part description <span class="req">required</span></label>
              <textarea id="description" name="description" rows="4" required aria-describedby="description-hint" maxlength="2000"></textarea>
              <span class="hint" id="description-hint">What the part is and roughly how big. No drawings, dimensions tables or technical data.</span>
            </div>
            <div class="row row--3">
              <div class="field"><label for="weight">Approx. weight per part (lb)</label><input id="weight" name="weight" inputmode="decimal" /></div>
              <div class="field"><label for="quantity">Annual quantity <span class="req">required</span></label><input id="quantity" name="quantity" inputmode="numeric" required /></div>
              <div class="field"><label for="needed">Needed by</label><input id="needed" name="needed" type="date" /></div>
            </div>
            <div class="row">
              <div class="field"><label for="program">Program or platform</label><input id="program" name="program" placeholder="e.g. UH-60, commercial" /></div>
              <div class="field"><label for="notes">Anything else</label><input id="notes" name="notes" maxlength="500" /></div>
            </div>
          </fieldset>

          <div class="submit">
            <button class="btn btn--primary" type="submit">Send request</button>
            <p class="hint">We use these details only to respond to your request. <a href={url('/privacy/')}>Privacy policy</a></p>
          </div>
        </form>

        <div class="done" data-done tabindex="-1" hidden>
          <h3>Request received</h3>
          <p data-done-msg>Thanks. We’ll reply with questions or a quote, and a secure link if we need drawings.</p>
        </div>
      </div>

      <aside class="rfq__side" aria-labelledby="direct">
        <h2 id="direct">Talk to us directly</h2>
        <dl class="contact">
          <div><dt>Phone</dt><dd><a href={company.phoneHref}>{company.phone}</a></dd></div>
          <div><dt>Second line</dt><dd>{company.phoneAlt}<Confirm id="phone2" /></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a><Confirm id="email" /></dd></div>
        </dl>
        <div id="visit" class="visit">
          <h2>Visit</h2>
          <address>{company.name}<br />{company.street}<br />{company.city}, {company.region} {company.postal}</address>
          <a class="btn btn--ghost" href={mapHref} rel="noopener" target="_blank">Open in Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-rfq]');
  const summary = document.querySelector<HTMLElement>('[data-errors]');
  const list = document.querySelector<HTMLUListElement>('[data-error-list]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  const msg = document.querySelector<HTMLElement>('[data-done-msg]');

  const messageFor = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
    const label = document.querySelector(`label[for="${el.id}"]`)?.firstChild?.textContent?.trim() ?? el.name;
    if (el.validity.valueMissing) return el instanceof HTMLSelectElement ? `Choose a ${label.toLowerCase()}` : `Enter your ${label.toLowerCase()}`;
    if (el.validity.typeMismatch) return `Enter a valid ${label.toLowerCase()}, like name@company.com`;
    return `Check ${label.toLowerCase()}`;
  };

  const showError = (el: HTMLElement, text: string) => {
    const id = `${el.id}-error`;
    let err = document.getElementById(id);
    if (!err) {
      err = document.createElement('span');
      err.id = id; err.className = 'err';
      el.insertAdjacentElement('afterend', err);
    }
    err.textContent = text;
    el.setAttribute('aria-invalid', 'true');
    el.setAttribute('aria-describedby', [id, el.getAttribute('aria-describedby')?.replace(id, '').trim()].filter(Boolean).join(' '));
  };
  const clearError = (el: HTMLElement) => {
    document.getElementById(`${el.id}-error`)?.remove();
    el.removeAttribute('aria-invalid');
    const rest = el.getAttribute('aria-describedby')?.replace(`${el.id}-error`, '').trim();
    rest ? el.setAttribute('aria-describedby', rest) : el.removeAttribute('aria-describedby');
  };

  form?.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((el) => {
    el.addEventListener('input', () => { if (el.checkValidity()) clearError(el); });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !summary || !list) return;
    const fields = [...form.querySelectorAll<HTMLInputElement>('input, select, textarea')];
    const bad = fields.filter((f) => !f.checkValidity());
    fields.forEach(clearError);
    list.innerHTML = '';
    if (bad.length) {
      bad.forEach((f) => {
        const text = messageFor(f);
        showError(f, text);
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${f.id}`; a.textContent = text;
        a.addEventListener('click', (ev) => { ev.preventDefault(); f.focus(); });
        li.append(a); list.append(li);
      });
      summary.hidden = false; summary.focus();
      return;
    }
    summary.hidden = true;
    const demo = form.dataset.demo === 'true';
    if (!demo) {
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
      } catch {
        list.innerHTML = '<li>We could not send your request. Call us or email us directly; nothing was lost on your side.</li>';
        summary.hidden = false; summary.focus();
        return;
      }
    } else if (msg) {
      msg.textContent = 'Preview build: your request was checked but not sent anywhere. At launch it goes straight to our sales team.';
    }
    form.hidden = true;
    if (done) { done.hidden = false; done.focus(); }
  });
</script>

<style>
  .rfq { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--s-8); align-items: start; }
  @media (max-width: 60rem) { .rfq { grid-template-columns: 1fr; gap: var(--s-7); } }
  .rfq__form > h2, .rfq__side h2 { font-size: var(--t-xl); margin-bottom: var(--s-4); }
  .cui { border-left: 3px solid var(--straw); background: #fbf6ea; padding: var(--s-4) var(--s-5); margin-bottom: var(--s-6); display: grid; gap: var(--s-2); }
  .cui p { font-size: var(--t-sm); color: var(--ink-2); }
  form { display: grid; gap: var(--s-6); }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-4); }
  legend { font-weight: 700; font-size: var(--t-lg); font-variation-settings: 'wdth' 108; padding: 0; margin-bottom: var(--s-4); border-top: 2px solid var(--ink); padding-top: var(--s-3); width: 100%; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
  .row--3 { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 40rem) { .row, .row--3 { grid-template-columns: 1fr; } }
  .field { display: grid; gap: var(--s-1); align-content: start; }
  label { font-weight: 600; font-size: var(--t-sm); }
  .req { font-weight: 450; color: var(--ink-3); font-size: var(--t-xs); margin-left: 0.25rem; }
  input, select, textarea {
    font: inherit; font-size: var(--t-md); color: var(--ink); background: var(--paper);
    border: 1px solid #8994a1; border-radius: var(--radius); padding: 0.65rem 0.75rem; min-height: 2.875rem; width: 100%;
  }
  textarea { resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { border-color: var(--temper); }
  [aria-invalid='true'] { border-color: var(--error); border-width: 2px; }
  :global(.err) { color: var(--error); font-size: var(--t-sm); font-weight: 600; }
  .hint { font-size: var(--t-sm); color: var(--ink-3); }
  .submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .errors { border: 2px solid var(--error); border-radius: var(--radius); padding: var(--s-4) var(--s-5); margin-bottom: var(--s-5); }
  .errors h3 { font-size: var(--t-md); color: var(--error); margin-bottom: var(--s-2); }
  .errors :global(ul) { padding-left: 1.2rem; }
  .errors :global(a) { color: var(--error); }
  .done { border-top: 2px solid var(--ok); background: #eef6f1; padding: var(--s-5); display: grid; gap: var(--s-2); margin-top: var(--s-6); }
  .done:focus, .errors:focus { outline: none; }
  .rfq__side { display: grid; gap: var(--s-7); position: sticky; top: 7.5rem; }
  .contact { margin: 0; border-top: 2px solid var(--ink); }
  .contact div { display: grid; grid-template-columns: 7rem 1fr; padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  .contact dt { color: var(--ink-3); font-size: var(--t-sm); }
  .contact dd { margin: 0; overflow-wrap: anywhere; }
  .visit { display: grid; gap: var(--s-4); justify-items: start; }
  .visit address { font-style: normal; line-height: 1.7; }
  @media (max-width: 60rem) { .rfq__side { position: static; } }
</style>
