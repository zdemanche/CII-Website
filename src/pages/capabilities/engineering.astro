---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionNav from '../../components/SectionNav.astro';
import Photo from '../../components/Photo.astro';
import { engineering } from '../../data/capabilities';
import { capabilityLinks } from '../../data/sections';
import { url } from '../../lib/url';
---
<Base title="Engineering services" description="Forging design and redesign, DEFORM process simulation, metallurgical and metal-flow analysis, laser scanning and 3-D die models.">
  <PageHeader photo="deform-simulation" title="Engineering services" lede="Many of our customers bring us a part, not a forging. Our engineers help design the forging, then prove the process before steel is cut for dies." />
  <SectionNav label="Capabilities" links={capabilityLinks} />
  <section class="section section--paper">
    <div class="wrap eng-grid">
      {engineering.map((e) => (
        <div class="eng"><h2>{e.title}</h2><p>{e.body}</p></div>
      ))}
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <div class="section-head">
          <h2>Bring us the model</h2>
          <p>Start with a request for quote describing the part. We’ll send a secure link for the model and drawings so controlled technical data never travels by ordinary email.</p>
        </div>
        <a class="btn btn--primary" href={url('/contact/#rfq')}>Request a quote</a>
      </div>
      <Photo slug="laser-scanning" sizes="(min-width: 52rem) 55vw, 100vw" />
    </div>
  </section>
</Base>
<style>
  .eng-grid { display: grid; gap: var(--s-6); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 48rem) { .eng-grid { grid-template-columns: 1fr; } }
  .eng { border-top: 2px solid var(--ink); padding-top: var(--s-4); display: grid; gap: var(--s-3); align-content: start; }
  .eng h2 { font-size: var(--t-xl); }
  .eng p { color: var(--ink-2); }
</style>
