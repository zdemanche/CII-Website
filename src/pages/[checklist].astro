---
/** Launch checklist — built only for DEMO previews. Lists every fact awaiting CII confirmation. */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { pending, completed } from '../data/pending';
export function getStaticPaths() {
  return process.env.DEMO === '1' ? [{ params: { checklist: 'launch-checklist' } }] : [];
}
const areas = [...new Set(pending.map((p) => p.area))];
const repo = 'https://github.com/zdemanche/CII-Website/issues/';
---
<Base title="Launch checklist" description="Steps remaining before the new site goes live." noindex>
  <PageHeader title="Launch checklist" lede={`${pending.length} steps left between this preview and www.forgemetal.com. Each links to its tracking issue.`} />
  <section class="section section--paper">
    <div class="wrap">
      {areas.map((a) => (
        <section class="area" aria-labelledby={`a-${a}`}>
          <h2 id={`a-${a}`}>{a}</h2>
          <ul>
            {pending.filter((p) => p.area === a).map((p) => (
              <li id={p.id}>
                <span>{p.item}</span>
                <span class="links"><a href={`${repo}${p.issue}`} rel="noopener">Issue #{p.issue}</a></span>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <section class="area done" aria-labelledby="a-done">
        <h2 id="a-done">Done</h2>
        <ul>
          {completed.map((c) => (
            <li><span>{c.item}</span><span class="links"><a href={`${repo}${c.issue}`} rel="noopener">Issue #{c.issue}</a></span></li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</Base>
<style>
  .area + .area { margin-top: var(--s-7); }
  .area h2 { font-size: var(--t-xl); margin-bottom: var(--s-3); }
  .area ul { list-style: none; border-top: 2px solid var(--ink); }
  .area li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-5); padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  .area li:target { background: #fbf6ea; }
  .links { display: flex; gap: var(--s-4); font-size: var(--t-sm); white-space: nowrap; }
  .done li span:first-child { color: var(--ink-2); }
  .done li span:first-child::before { content: '✓ '; color: var(--ok); font-weight: 700; }
</style>
