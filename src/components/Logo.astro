---
interface Props { tone?: 'ink' | 'light' }
const { tone = 'ink' } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="30" height="30" rx="3" fill="currentColor" />
    <g fill="none" stroke="var(--logo-bg)" stroke-width="1.6" stroke-linecap="round">
      <path d="M4 9c6 0 8 1.5 12 1.5S24 9 28 9" />
      <path d="M4 13.5c5 0 6.5-1.8 8.5-1.8" /><path d="M19.5 11.7c2 0 3.5 1.8 8.5 1.8" />
      <path d="M4 18.5c5 0 6.5 1.8 8.5 1.8" /><path d="M19.5 20.3c2 0 3.5-1.8 8.5-1.8" />
      <path d="M4 23c6 0 8-1.5 12-1.5S24 23 28 23" />
    </g>
    <circle cx="16" cy="16" r="3.6" fill="none" stroke="var(--logo-bg)" stroke-width="1.6" />
  </svg>
  <span class="logo__word"><b>Consolidated</b> Industries</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); --logo-bg: var(--paper); }
  .logo--light { color: var(--on-steel); --logo-bg: var(--steel); }
  .logo__mark { width: 2rem; height: 2rem; flex: none; }
  .logo__word { font-size: 1.05rem; font-variation-settings: 'wdth' 118; font-weight: 450; letter-spacing: -0.01em; white-space: nowrap; }
  .logo__word b { font-weight: 750; }
  @media (max-width: 26rem) { .logo { gap: 0.45rem; } .logo__mark { width: 1.75rem; height: 1.75rem; } .logo__word { font-size: 0.92rem; font-variation-settings: 'wdth' 106; } }
</style>
