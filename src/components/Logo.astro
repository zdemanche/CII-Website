---
import logo from '../assets/cii-logo.png';
interface Props { tone?: 'ink' | 'plate'; decorative?: boolean }
const { tone = 'ink', decorative = false } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`]}>
  <img src={logo.src} width={logo.width} height={logo.height} alt={decorative ? '' : 'Consolidated Industries, Inc.'} decoding="async" />
</span>
<style>
  .logo { display: inline-flex; align-items: center; }
  .logo img { height: 2.6rem; width: auto; }
  .logo--plate { background: var(--paper); padding: 0.7rem 0.9rem; border-radius: 4px; }
  .logo--plate img { height: 2.4rem; }
  @media (max-width: 26rem) { .logo img { height: 2.15rem; } }
</style>
