---
/** Four icon cards on a white panel with a slanted backdrop: the "Market experience" block. */
import Icon from './Icon.astro';
import { url } from '../lib/url';
import type { Pillar } from '../data/home';
interface Props { title: string; lede: string; items: Pillar[]; id: string }
const { title, lede, items, id } = Astro.props;
---
<section class="pillars section" aria-labelledby={id}>
  <div class="wrap">
    <div class="pillars__panel">
      <div class="section-head">
        <h2 id={id}>{title}</h2>
        <p>{lede}</p>
      </div>
      <ul class="pillars__list">
        {items.map((it) => (
          <li>
            <span class="pillars__icon"><Icon name={it.icon} /></span>
            <h3>{it.title}</h3>
            <p>{it.body}</p>
            <a class="more" href={url(it.href)}>{it.link}<Icon name="arrow-right" /></a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .pillars { position: relative; isolation: isolate; overflow: hidden; }
  .pillars::before { content: ''; position: absolute; inset: 0 auto 0 0; width: clamp(6rem, 16vw, 16rem); background: var(--ink-3); opacity: 0.55; z-index: -1;
    clip-path: polygon(0 0, 100% 0, 55% 100%, 0 100%); }
  .pillars__panel { background: var(--paper); padding: var(--s-7) var(--s-6); box-shadow: 0 16px 48px rgb(23 32 43 / 0.1); }
  .pillars__list { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6) var(--s-5); }
  .pillars__list li { display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .pillars__icon { display: inline-grid; place-items: center; width: 3.25rem; height: 3.25rem; color: var(--temper); background: #e9eff9; border-radius: var(--radius); }
  .pillars__icon :global(.icon) { width: 1.75rem; height: 1.75rem; }
  .pillars h3 { font-size: var(--t-md); }
  .pillars li p { font-size: var(--t-sm); color: var(--ink-2); }
  @media (max-width: 62rem) { .pillars__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 36rem) { .pillars__list { grid-template-columns: 1fr; } .pillars__panel { padding: var(--s-6) var(--s-5); } }
</style>
