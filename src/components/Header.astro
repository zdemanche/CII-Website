---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav } from '../data/nav';
import { company } from '../data/company';
import { url, isActive } from '../lib/url';
const path = Astro.url.pathname;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(company.mapQuery)}`;
const idFor = (label: string) => `sub-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const exact = (href: string) => !href.includes('#') && path.replace(/\/$/, '') === url(href).replace(/\/$/, '');
---
<header class="site-header" data-header>
  <div class="util">
    <div class="wrap util__inner">
      <span class="util__label">Call us</span>
      <a href={company.phoneHref}><Icon name="phone" />{company.phone}</a>
      <a href={`mailto:${company.email}`}><Icon name="mail" />{company.email}</a>
      <a class="util__map" href={mapHref} rel="noopener" target="_blank"><Icon name="pin" />{company.street}, {company.city}, {company.region} {company.postal}<span class="visually-hidden"> (map, opens in a new tab)</span></a>
    </div>
  </div>
  <div class="wrap bar">
    <a class="bar__home" href={url('/')}><Logo /><span class="visually-hidden">, home</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="menu-btn__icon" aria-hidden="true"></span><span data-menu-label>Menu</span>
    </button>
    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav__list">
        {mainNav.map((l) => (
          <li class:list={['nav__item', { 'nav__item--sub': l.children }]} data-nav-item>
            <a href={url(l.href)} aria-current={isActive(path, l.href) ? 'page' : undefined}>{l.label}</a>
            {l.children && (
              <button class="nav__toggle" type="button" aria-expanded="false" aria-controls={idFor(l.label)} data-nav-toggle>
                <Icon name="chevron-down" /><span class="visually-hidden">{l.label} submenu</span>
              </button>
            )}
            {l.children && (
              <ul class="sub" id={idFor(l.label)}>
                {l.children.map((c) => <li><a href={url(c.href)} aria-current={exact(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn--primary nav__cta" href={url('/contact/#rfq')}>Request a quote</a>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    const label = btn.querySelector('[data-menu-label]');
    if (label) label.textContent = open ? 'Close' : 'Menu';
    header?.toggleAttribute('data-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) { btn?.click(); btn?.focus(); }
  });

  // Submenus: hover opens on fine pointers; the chevron button opens for touch and keyboard; Escape and outside clicks close.
  const desktop = matchMedia('(min-width: 62.01rem)');
  const hoverable = matchMedia('(hover: hover) and (pointer: fine)');
  const items = [...document.querySelectorAll<HTMLElement>('[data-nav-item]')].filter((i) => i.querySelector('[data-nav-toggle]'));
  const set = (item: HTMLElement, open: boolean) => {
    item.toggleAttribute('data-open', open);
    item.querySelector('[data-nav-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except?: HTMLElement) => items.forEach((i) => i !== except && set(i, false));
  for (const item of items) {
    const toggle = item.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
    toggle.addEventListener('click', () => {
      const open = !item.hasAttribute('data-open');
      if (open && desktop.matches) closeAll(item);
      set(item, open);
    });
    item.addEventListener('mouseenter', () => { if (hoverable.matches && desktop.matches) set(item, true); });
    item.addEventListener('mouseleave', () => { if (hoverable.matches && desktop.matches) set(item, false); });
    item.addEventListener('focusout', (e) => {
      if (desktop.matches && !item.contains(e.relatedTarget as Node | null)) set(item, false);
    });
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && item.hasAttribute('data-open')) { e.stopPropagation(); set(item, false); toggle.focus(); }
    });
  }
  document.addEventListener('click', (e) => { if (!header?.contains(e.target as Node)) closeAll(); });
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 0.96); backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--rule-soft); }
  .util { background: var(--ink); color: var(--on-steel-2); font-size: var(--t-xs); }
  .util__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-1) var(--s-5); padding-block: 0.4rem; }
  .util__label { color: var(--on-steel-2); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; margin-right: calc(var(--s-5) * -1 + var(--s-2)); }
  .util a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--on-steel); text-decoration: none; }
  .util a :global(.icon) { color: #a9c3f0; }
  .util a:hover { text-decoration: underline; color: var(--paper); }
  .util__map { margin-left: auto; }
  .bar { display: flex; align-items: center; gap: var(--s-5); min-height: 4.25rem; }
  .bar__home { text-decoration: none; margin-right: auto; display: inline-flex; }
  .nav { display: flex; align-items: center; gap: var(--s-5); }
  .nav__list { list-style: none; display: flex; gap: var(--s-1); }
  .nav__item { position: relative; display: flex; align-items: center; }
  .nav__list > li > a { display: block; padding: 0.55rem 0.75rem; color: var(--ink); text-decoration: none; font-weight: 550; font-size: var(--t-sm); border-radius: var(--radius); }
  .nav__item--sub > a { padding-right: 0.35rem; }
  .nav__list > li > a:hover { background: var(--mill); }
  .nav__list > li > a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--temper); border-radius: 0; }
  .nav__toggle { display: inline-flex; align-items: center; justify-content: center; width: 1.75rem; height: 2.25rem; margin-right: 0.25rem;
    border: 0; background: none; color: var(--ink-3); cursor: pointer; border-radius: var(--radius); }
  .nav__toggle:hover { background: var(--mill); color: var(--ink); }
  .nav__toggle :global(.icon) { transition: transform 0.2s; }
  .nav__item[data-open] .nav__toggle :global(.icon) { transform: rotate(180deg); }
  .sub { list-style: none; display: none; position: absolute; top: calc(100% + 0.35rem); left: 0; min-width: 15rem; padding: var(--s-2);
    background: var(--paper); border: 1px solid var(--rule-soft); border-top: 2px solid var(--temper); border-radius: var(--radius); box-shadow: 0 12px 32px rgb(23 32 43 / 0.14); z-index: 5; }
  .sub a { display: block; padding: 0.55rem 0.75rem; color: var(--ink-2); text-decoration: none; font-size: var(--t-sm); border-radius: var(--radius); }
  .sub a:hover { background: var(--mill); color: var(--ink); }
  .sub a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  .nav__item[data-open] > .sub { display: block; }
  :global(.no-js) .nav__item--sub:hover > .sub, :global(.no-js) .nav__item--sub:focus-within > .sub { display: block; }
  :global(.no-js) .nav__toggle { display: none; }
  .menu-btn { display: none; }
  @media (max-width: 26rem) { .bar { gap: var(--s-3); } }
  @media (max-width: 62rem) {
    .util__inner { justify-content: flex-start; }
    .util .util__map, .util__label { display: none; }
    .menu-btn {
      display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 0.9rem;
      font: inherit; font-weight: 600; font-size: var(--t-sm); background: none; color: var(--ink);
      border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer;
    }
    .menu-btn__icon, .menu-btn__icon::before { display: block; width: 1rem; height: 2px; background: currentColor; position: relative; }
    .menu-btn__icon::before { content: ''; position: absolute; top: 5px; }
    .menu-btn__icon { transform: translateY(-2.5px); }
    .nav { display: none; position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: stretch; gap: var(--s-4);
      background: var(--paper); border-bottom: 1px solid var(--rule); padding: var(--s-4) 1.25rem var(--s-5); max-height: calc(100vh - 100%); overflow-y: auto; }
    .site-header[data-open] .nav { display: flex; }
    .nav__list { flex-direction: column; }
    .nav__item { flex-wrap: wrap; border-bottom: 1px solid var(--rule-soft); }
    .nav__list > li > a { flex: 1; padding: 0.8rem 0.5rem; font-size: var(--t-md); border-radius: 0; }
    .nav__list > li > a[aria-current='page'] { box-shadow: inset 3px 0 0 var(--temper); }
    .nav__toggle { width: 2.75rem; height: 2.75rem; margin: 0; color: var(--ink); border-left: 1px solid var(--rule-soft); border-radius: 0; }
    .sub { position: static; flex-basis: 100%; min-width: 0; border: 0; border-top: 1px solid var(--rule-soft); box-shadow: none; padding: var(--s-2) 0 var(--s-3) var(--s-4); background: var(--mill); }
    .sub a { padding: 0.6rem 0.5rem; }
    .nav__cta { justify-content: center; }
  }
  :global(.no-js) .site-header .nav { display: flex; position: static; }
  :global(.no-js) .menu-btn { display: none; }
</style>
