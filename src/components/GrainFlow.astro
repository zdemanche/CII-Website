---
import { grainflow, presets } from '../lib/grainflow';
interface Props { preset?: keyof typeof presets; animate?: boolean; class?: string }
const { preset = 'plain', animate = false, class: cls = '' } = Astro.props;
const art = grainflow(presets[preset]);
const gid = `temper-${preset}`;
---
<svg
  class:list={['grain', cls, { 'grain--animate': animate }]}
  viewBox={`0 0 ${art.width} ${art.height}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={gid} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={art.width * 0.15} y2={art.height}>
      <stop offset="0" stop-color="#d9ab52" />
      <stop offset="0.38" stop-color="#bf7445" />
      <stop offset="0.62" stop-color="#8a64b4" />
      <stop offset="1" stop-color="#5287d8" />
    </linearGradient>
  </defs>
  <g fill="none" stroke={`url(#${gid})`} stroke-width="1.3" stroke-linecap="round">
    {art.paths.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
  </g>
  <g fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="1">
    {art.bosses.map((b) => <circle cx={b.x} cy={b.y} r={b.r * 0.92} />)}
  </g>
</svg>
<style>
  .grain { width: 100%; height: 100%; color: var(--on-steel); }
  .grain path { stroke-opacity: 0.92; }
  @media (prefers-reduced-motion: no-preference) {
    .grain--animate path {
      stroke-dasharray: 1; stroke-dashoffset: 1;
      animation: draw 2.4s cubic-bezier(.3,.6,.2,1) forwards;
      animation-delay: calc(var(--i) * 28ms);
    }
    @keyframes draw { to { stroke-dashoffset: 0; } }
  }
</style>
