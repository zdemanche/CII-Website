---
import GrainFlow from './GrainFlow.astro';
import { presets } from '../lib/grainflow';
import { Picture } from 'astro:assets';
import { photo as getPhoto } from '../data/photos';
interface Props { title: string; lede?: string; preset?: keyof typeof presets; crumbs?: { href: string; label: string }[]; photo?: string }
import { url } from '../lib/url';
const { title, lede, preset = 'plain', crumbs = [], photo } = Astro.props;
const ph = photo ? getPhoto(photo) : null;
---
<header class:list={['ph', { 'ph--photo': ph }]}>
  {ph ? (
    <div class="ph__photo"><Picture src={ph.src} alt={ph.alt} formats={['avif', 'webp']} widths={[480, 800, ph.src.width].filter((w) => w <= ph.src.width)} sizes="(min-width: 56rem) 55vw, 100vw" loading="eager" /></div>
  ) : (
    <div class="ph__art"><GrainFlow preset={preset} /></div>
  )}
  <div class="wrap ph__inner">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="ph__crumbs">
        <ol>{crumbs.map((c) => <li><a href={url(c.href)}>{c.label}</a></li>)}</ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lede && <p class="ph__lede">{lede}</p>}
    <slot />
  </div>
</header>
<style>
  .ph { position: relative; background: var(--steel); color: var(--on-steel); overflow: hidden; isolation: isolate; }
  .ph__art { position: absolute; inset: 0; z-index: -1; opacity: 0.9;
    mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.35) 38%, #000 70%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.35) 38%, #000 70%); }
  .ph__inner { padding-block: var(--s-8) var(--s-7); }
  .ph h1 { max-width: 18ch; }
  .ph__lede { margin-top: var(--s-4); font-size: var(--t-lg); line-height: 1.5; color: var(--on-steel-2); max-width: 40rem; }
  .ph__crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-4); font-size: var(--t-sm); }
  .ph__crumbs li + li::before { content: '/'; margin-right: var(--s-2); color: var(--on-steel-2); }
  .ph__crumbs a { color: var(--on-steel-2); }
  .ph__crumbs a:hover { color: var(--on-steel); }
  .ph__photo { position: absolute; inset: 0 0 0 auto; width: min(58%, 52rem); z-index: -1; }
  .ph__photo :global(picture), .ph__photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ph__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--steel) 0%, rgb(28 38 50 / 0.55) 30%, rgb(28 38 50 / 0.12) 70%); }
  .ph--photo .ph__inner { min-height: 20rem; display: flex; flex-direction: column; justify-content: flex-end; }
  @media (max-width: 40rem) {
    .ph__art { opacity: 0.45; }
    .ph__photo { width: 100%; }
    .ph__photo::after { background: linear-gradient(180deg, rgb(28 38 50 / 0.5), var(--steel) 92%); }
  }
</style>
